# Copy to .env and replace every placeholder. Never commit .env.
APP_ENV=development
APP_NAME=Provenance
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL for deployment. SQLite works for local experiments only.
DATABASE_URL=postgresql+psycopg://companydata:companydata@localhost:5432/companydata
# DATABASE_URL=sqlite:///./dev.sqlite3

# SEC fair access: product name + a monitored contact address. Required.
SEC_USER_AGENT="Provenance/0.1.0 contact=ops@example.com"
SEC_MIN_REQUEST_INTERVAL_SECONDS=0.25
SEC_TIMEOUT_SECONDS=20
SEC_MAX_RETRIES=5
SEC_CACHE_DIR=.sec_cache
SEC_LIVE_TESTS=0

INGESTION_POLL_INTERVAL_SECONDS=300
# Newly detected filings older than this many days are backfill and never trigger notifications
NOTIFY_MAX_FILING_AGE_DAYS=30
# Universe (bulk coverage): refresh cadence, SEC request budget per poller pass, failure cutoff,
# and how many older-filings pages (each ~1,000 filings) to pull per company beyond `recent`.
UNIVERSE_REFRESH_INTERVAL_SECONDS=21600
UNIVERSE_REQUEST_BUDGET_PER_RUN=400
UNIVERSE_MAX_CONSECUTIVE_FAILURES=10
SEC_FILINGS_HISTORY_PAGES=0
FRESHNESS_STALE_AFTER_SECONDS=86400
ON_DEMAND_INGESTION_ENABLED=true
# International listings (ADR 0006). Enabled sources run in scripts/ingest_markets.py --all.
# tsx and cse have non-commercial terms: enable only with written permission from TMX / the CSE.
MARKETS_SOURCES_ENABLED=esma_firds,fca_firds,gleif
MARKETS_FIRDS_DAYS_BACK=3
MARKETS_GLEIF_LOOKUPS_PER_RUN=50
MARKETS_CACHE_DIR=.markets_cache
MARKETS_TIMEOUT_SECONDS=60
# Public website showcase: comma-separated CIKs, or empty for the most recently filed ingested companies
PUBLIC_SHOWCASE_CIKS=
PUBLIC_SHOWCASE_LIMIT=12

# Secrets: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=replace-with-random-secret
WEBHOOK_SIGNING_SECRET=replace-with-random-secret
# Optional: enables POST /v1/developer/api-keys. Leave empty to disable the endpoint.
ADMIN_TOKEN=

MAX_EXPORT_ROWS=1000
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_MONTHLY_REQUEST_QUOTA=10000

WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_SECONDS=30
# true only on a developer machine to test against http://127.0.0.1 receivers
WEBHOOK_ALLOW_PRIVATE_DESTINATIONS=false

# Email notifications are optional. Leave EMAIL_PROVIDER=none to disable.
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
